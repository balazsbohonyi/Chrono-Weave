# Environment Configuration Example
# 
# For DEVELOPMENT: Copy this to .env.local
# For PRODUCTION: Copy this to .env.production
#
# Both files are gitignored to prevent committing secrets.

# AI Provider Configuration
# Valid values: gemini, openrouter, ollama
PROVIDER=gemini

# API Key for Gemini or OpenRouter (unused for Ollama)
# Gemini: https://aistudio.google.com/apikey
# OpenRouter: https://openrouter.ai/keys
API_KEY=your_api_key_here

# Model ID (Optional)
# If omitted, defaults to: gemini-2.5-flash (Gemini) or openai/gpt-oss-120b (OpenRouter)
# Gemini Example: gemini-2.5-flash
# OpenRouter Examples: openai/gpt-oss-120b, anthropic/claude-3.5-sonnet, meta-llama/llama-3.3-70b-instruct
MODEL=gemini-2.5-flash

# Ollama examples (use one configuration at a time):
# Local server, including cloud models through a signed-in Ollama installation:
# PROVIDER=ollama
# OLLAMA_MODE=local
# MODEL=gpt-oss:20b-cloud
# OLLAMA_BASE_URL=http://localhost:11434
# No API key is required in local mode.

# Direct Ollama Cloud, through the local ChronoWeave server relay:
# PROVIDER=ollama
# OLLAMA_MODE=cloud
# MODEL=gpt-oss:20b
# OLLAMA_API_KEY=your_ollama_cloud_api_key
# Create a key at https://ollama.com/settings/keys
# OLLAMA_API_KEY is server-only and is never included in the frontend bundle.
# Alternatively, enter a cloud key in Settings and click Save to retain it.
# Cloud model IDs come from the cloud catalog and can differ from local aliases.
# Reasoning is off by default in both modes. Set true to opt in (supported models).
# GPT-OSS uses low effort when off, medium when on; it cannot fully disable reasoning.
# OLLAMA_REASONING=false

